# 统一换行符：源码 LF，避免 Windows 用户提交 CRLF 导致容器脚本 exec format error
* text=auto eol=lf

*.py text
*.js text
*.css text
*.html text
*.md text
*.yml text
*.yaml text
*.toml text
*.json text
*.sh text eol=lf
*.bat text eol=crlf
Dockerfile text eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
*.mp3 binary
*.wav binary
*.xlsx binary