# ═══════════════════════════════════════════════════════
# 漫画配音工坊 — 环境变量示例
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交。
#   cp .env.example .env
# ═══════════════════════════════════════════════════════

# ── 零配置演示：不需要任何 Key / ffmpeg ──────────────
# 设为 1 时强制使用内置 Mock（模拟 OCR / LLM / 静音 TTS），
# 可完整体验上传、翻页、逐句高亮、换音色。
MOCK_MODE=0

# ── DeepSeek（剧本合并 / 角色选音）────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名必须与你的账号/网关可用模型一致（官方常用：deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat
# 结构化 JSON 任务关闭思考；需要时改 1
DEEPSEEK_THINKING=0
DEEPSEEK_MAX_TOKENS=32768

# ── 千问 TTS（DashScope / 百炼 · WebSocket）──────────
QWEN_API_KEY=sk-your-dashscope-key
QWEN_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
QWEN_TTS_MODEL=qwen-audio-3.0-tts-plus
QWEN_TTS_ENABLED=1

# ── 千问视觉 OCR（DashScope / 百炼 · OpenAI 兼容 REST）─
QWEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 如视觉与 TTS 使用不同 Key，可单独覆盖：
# QWEN_VISION_API=sk-your-vision-key
QWEN_VISION_MODEL=qwen3.6-flash
# 注：TTS/视觉模型名需与你的百炼工作空间可用模型一致；上面为项目默认值。
# OCR 关闭思考（每页识别提速数倍）；需要时改 1
QWEN_VISION_THINKING=0
QWEN_VISION_ENABLED=1
VISION_PROVIDER=qwen

# ── 供应商开关 ───────────────────────────────────────
# tts: qwen | fish | mock ；vision: qwen | mock ；llm: deepseek | mock
TTS_PROVIDER=qwen
LLM_PROVIDER=deepseek

# 可选：Fish Audio 作为备选 TTS
# FISH_AUDIO_API_KEY=

# ── 服务与部署 ───────────────────────────────────────
# 本地默认只监听 127.0.0.1；Docker 内由镜像设为 0.0.0.0
HOST=127.0.0.1
PORT=8080
# 数据目录（Docker 中为 /data，由 volume 挂载）
# DATA_DIR=./data
# 上传限制
MAX_UPLOAD_MB=256
MAX_UPLOAD_FILES=500
# 可选：指定 ffmpeg；设为 off 可强制使用纯 WAV 拼接
# FFMPEG_BIN=/usr/bin/ffmpeg